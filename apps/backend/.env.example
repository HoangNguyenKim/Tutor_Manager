# Copy to .env
HOST=127.0.0.1
PORT=3001
# Optional: random 256-bit hex; generated per boot when unset.
# LOCAL_TOKEN=
DATA_DIR=./data
LOG_LEVEL=log
# Dev/migration database for Prisma CLI (runtime uses DATA_DIR instead).
DATABASE_URL="file:./prisma/dev.db"
# Comma-separated extra allowed Origin values (dev Vite defaults are built in).
# ALLOWED_ORIGINS=
